# Dùng khi proxy ngoài đã kết thúc TLS và chuyển request HTTP nội bộ về Ubuntu.
# Frontend nhận ở cổng 80, API nhận ở cổng 8082. Proxy ngoài phải gửi
# X-Forwarded-Proto: https; Nginx này giữ nguyên header đó để API không
# redirect HTTPS sai. Các container chỉ bind localhost.

server {
    listen 80;
    server_name clm.vnptninhbinh.com.vn;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Proxy ngoài phải ghi đè X-Forwarded-For bằng đúng IP client.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 8082;
    server_name clm-api.vnptninhbinh.com.vn;
    client_max_body_size 15m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Cổng 8082 phải được firewall chỉ cho IP proxy ngoài truy cập.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
