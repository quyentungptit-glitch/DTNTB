# Dùng khi proxy ngoài đã kết thúc TLS và chuyển request HTTP nội bộ về Ubuntu.
# Frontend nhận ở cổng 80 (kèm luôn API qua đường dẫn /api), API riêng ở cổng 8082 (tuỳ chọn,
# chỉ cần nếu vẫn muốn dùng tên miền clm-api). Proxy ngoài phải gửi
# X-Forwarded-Proto: https; Nginx này giữ nguyên header đó để API không
# redirect HTTPS sai. Các container chỉ bind localhost.

server {
    listen 80;
    server_name clm.vnptninhbinh.com.vn;
    # Trang gọi API qua /api trên chính địa chỉ này (container frontend chuyển tiếp vào API),
    # nên cần nhận được ảnh điểm danh (tối đa 5 ảnh) và chờ được lúc xuất Excel.
    client_max_body_size 15m;
    proxy_read_timeout 120s;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Proxy ngoài phải ghi đè X-Forwarded-For bằng đúng IP client.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 8082;
    server_name clm-api.vnptninhbinh.com.vn;
    client_max_body_size 15m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Cổng 8082 phải được firewall chỉ cho IP proxy ngoài truy cập.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
