# Sao chép file này thành .env trên Ubuntu. File .env không được commit;
# chỉ cấp quyền đọc cho người vận hành Docker.
SECRETS_DIR=/opt/dtntb/secrets

Jwt__Issuer=DTNTB
Jwt__Audience=DTNTB_CLIENT
Jwt__AccessTokenMinutes=30
Jwt__Key=THAY_BANG_JWT_KEY_TOI_THIEU_32_BYTE

ConnectionStrings__ConnectionString_NBH=THAY_BANG_CHUOI_KET_NOI_ORACLE

Cors__AllowedOrigins__0=https://clm.vnptninhbinh.com.vn
AllowedHosts=clm-api.vnptninhbinh.com.vn;localhost;127.0.0.1

# SSO vẫn phải dùng HTTPS trong production.
Sso__BaseUrl=https://THAY_BANG_HOST_SSO/
Sso__ApiKey=THAY_BANG_SSO_API_KEY
SystemToSystem__SecretKey=THAY_BANG_SYSTEM_TO_SYSTEM_KEY

# Storage HTTP chỉ được phép với IP private/loopback trong VLAN nội bộ.
RemoteStorage__BaseUrl=http://10.x.x.x:5000
RemoteStorage__AllowInsecureHttpForPrivateNetwork=true
RemoteStorage__InternalApiKey=THAY_BANG_STORAGE_INTERNAL_KEY

# Firebase vẫn dùng file /opt/dtntb/secrets/firebase-service-account.json.
# Nếu phải xác thực token cũ bằng khóa khác, thêm LegacyJwt__Key=... tại đây.
